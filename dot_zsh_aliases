if [[ $ZSH_EVAL_CONTEXT != *:file ]]; then (
  b64_aliases_test () {
    echo "Testing b64 and b64d aliases:"
    local test_string='
    multiline
    test
    '
    if [[ $(echo "$test_string" | b64 | b64d) != "$test_string" ]]; then
      echo "Failed."
      return 1
    fi
    echo "Pass."
  }

  url_aliases_test() {
    echo "Testing urlencode and decode:"
    local -a cases=(
      ''                  ''
      'abcXYZ012-._~'     'abcXYZ012-._~'
      'hello world'       'hello%20world'
      'a+b/c?x=1&y=2%'   'a%2Bb%2Fc%3Fx%3D1%26y%3D2%25'
      'café'              'caf%C3%A9'
      $'first\nsecond'    'first%0Asecond'
      'a\nb'              'a%5Cnb'
    )
    local input encoded actual
    local -i i failed=0

    for (( i = 1; i <= ${#cases}; i += 2 )); do
      input=${cases[i]}
      encoded=${cases[i+1]}
      result="$(printf '%s' "$input" | urlencode)"
      if [[ $result != "$encoded" ]]; then
        echo "Encode decode failed for $input. Expected $encoded, got $result"
        failed=1
      fi
    done

    # if ! actual=$(urldecode 'hello+world') || [[ $actual != 'hello world' ]]; then
    #   printf 'Decoding + failed: got %q\n' "$actual" >&2
    #   failed=1
    # fi

    if (( failed )) && return 1
    echo "Pass."
  }

  echo "Running tests:"
