# ============ Enconding/Crypto ============

sbuff () {
  read -s BUFF && echo "$BUFF" | sha512sum
  unset BUFF
}

pipebuff() {
  local log=${1:?Please provide an operation to log}
  local quiet=${2:-false}
  shift 2

  (( $# )) || failerror 1 "No command provided."

  if [ -t 0 ]; then
    local buff
    printf 'Please provide input to %s:\n' "$log" >&2
    printrow
    IFS= read -r  buff || { failerror 1 "Failed to read buffer."; return 1; }
    printf '%s output:\n' "$log" >&2
    printrow

    if [[ $quiet == true ]]; then
      printf '%s' "$buff" | "$@" 2>/dev/null
    else
      printf '%s' "$buff" | "$@"
    fi
  else
    if [[ $quiet == true ]]; then
      "$@" 2>/dev/null
    else
      "$@"
    fi
  fi
}

b64() {
  if ! pipebuff "base64 ENCODE" false base64; then
    failerror 1 "Failed to base64 ENCODE"
  fi
}

b64d() {
  if ! pipebuff "base64 DECODE" false base64 -d; then
    echo >&2
    failerror 1 "Failed to base64 DECODE"
  fi
}

urlencode() {
  local LC_ALL=C char buff
  local -i i
  IFS= read -r -d '' buff
  for (( i = 1; i <= ${#buff}; i++ )); do
    char=${buff[i]}
    case $char in
      [a-zA-Z0-9.~_-]) printf '%s' "$char" ;;
      *) printf '%%%02X' "'$char" ;;
    esac
  done
  printf '\n'
}

urldecode() {
  local buff
  IFS= read -r -d '' buff
  buff=${buff//+/ }
  buff=${buff//\\/\\\\}
  printf '%b\n' "${buff//\%/\\x}"
EOF
}

url () {
  pipebuff "url ENCODE" true urlencode
}

urld () {
  pipebuff "url DECODE" true urldecode
}

qr () {
  pipebuff "QR ENCODE" true qrencode -t ansiutf8
}

