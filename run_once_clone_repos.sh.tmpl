{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
set -euo pipefail

# ============ GOTO ============

git clone https://github.com/iridakos/goto.git "${HOME}/.local/share/goto"

# Enable GOTO
source "${HOME}/.local/share/goto/goto.sh"

# ============ TMUX PLUGIN MANAGER ============

git clone https://github.com/tmux-plugins/tpm "${HOME}/.tmux/plugins/tpm"

# ============ ZSH ============

git clone https://github.com/ohmyzsh/ohmyzsh.git "${HOME}/.oh-my-zsh"
git clone https://github.com/zsh-users/zsh-autosuggestions "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins/zsh-autosuggestions"
git clone https://github.com/zsh-users/zsh-syntax-highlighting "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins/zsh-syntax-highlighting"

# ============ NVIM Kickstart ============

# requires some dependencies... check the git
git clone https://github.com/agneroth/kickstart.nvim.git "${XDG_CONFIG_HOME:-$HOME/.config}"/nvim
{{ end }}
